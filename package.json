{
  "name": "apex",
  "version": "0.1.0",
  "private": true,
  "description": "A 股 AI 交易闭环系统 - 前后端统一启动编排",
  "scripts": {
    "setup": "uv pip install -r requirements.txt && cd frontend && npm install",
    "setup:backend": "uv pip install -r requirements.txt",
    "setup:frontend": "cd frontend && npm install",
    "dev": "concurrently --kill-others -n \"backend,frontend\" -c \"green,cyan\" \"npm run backend\" \"npm run frontend\"",
    "backend": "uv run uvicorn backend.main:app --reload --port 8000",
    "frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
